# ANALYZE=true
BLOG_PORT=4321

# 铃月 Vercel/Neon：只配置在服务端，绝不要使用 PUBLIC_ 前缀。
# DATABASE_URL=postgresql://运行时账号:密码@数据库主机/数据库?sslmode=verify-full
# KNOWLEDGE_DATABASE_URL=postgresql://发布账号:密码@数据库主机/数据库?sslmode=verify-full
# CHAT_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
# CHAT_MODEL=deepseek-v4.1-flash-1017
# CHAT_API_KEY=
# SILICONFLOW_API_KEY=
# COOKIE_SECRET=至少32字符的随机值
# SITE_ORIGIN=https://belluna.love
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DAILY_VISITOR_LIMIT=20
# USER_COOLDOWN_SECONDS=10
# MODEL_START_INTERVAL_SECONDS=2
# MODEL_COOLDOWN_SECONDS=30
# MAX_CONCURRENT=2

# Required only when config/site.yaml has moments.enabled: true.
# It must be a public origin reachable by both the Astro Node container and browsers.
# KOHARU_SUITE_URL=https://suite.example.com

