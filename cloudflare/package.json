{
  "name": "belluna-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "sync": "node --import tsx scripts/sync.ts",
    "sync:local": "node --import tsx scripts/local-sync.ts",
    "migrate": "wrangler d1 migrations apply lingyue-knowledge --remote"
  },
  "dependencies": {
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
