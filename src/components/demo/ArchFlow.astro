---
/**
 * 教学组件：架构卡片流
 * 模仿「入口 → 队列 → Agent Loop」的分层架构图：
 * - 每层一张卡片（kicker 小标 + 标题 + 描述），层间箭头衔接
 * - 底部一行"路由播报"，由客户端脚本轮播不同优先级的消息
 * - 样式全部 scoped（Astro 自动加 astro-xxx 哈希，不会污染全局）
 *
 * 用法（.mdx 文章中）：
 *   import ArchFlow from '@components/demo/ArchFlow.astro';
 *   <ArchFlow />
 */
interface Props {
  /** 可选：覆盖标题 */
  title?: string;
}
const { title = '自习室占座系统 · 数据与判定链路' } = Astro.props;

// 数据来自 wifi-seat-system-doc.md —— 全部是真实模块与真实流程
const layers = [
  {
    kicker: '◎ 采集端（App）',
    title: 'WiFi 指纹采集',
    sub: 'collector 账号登录采集模式，按批次提交样本（POST /api/v1/collector/batches）',
  },
  {
    kicker: '◎ 服务器（入库）',
    title: '指纹库 / 预处理',
    sub: '样本按批次合并入库，账号密码哈希存储，待复核状态不可用于训练',
    accent: true,
  },
  {
    kicker: '◎ 模型层',
    title: 'KNN + 决策树 双模型',
    sub: '同一批训练集跑两套算法，预测结果对照评估，输出置信度供阈值调优',
    accent: true,
  },
  {
    kicker: '◎ 用户端（App）',
    title: '查看 / 选座 / 会话',
    sub: 'user 账号实时查看座位占用状态，模型判定可疑占座后引导选座',
  },
  {
    kicker: '◎ 管理后台',
    title: '复核 / 看板 / 发布',
    sub: 'admin 复核样本与改状态；projectadmin 发布模型、控制系统配置',
  },
];

// 轮播内容同样来自真实业务规则（界面介绍.md 的权限与流程设计）
const routes = [
  { tag: '复核门槛', text: '采集批次提交后进入复核队列，admin 复核通过的样本才会进入训练集——脏数据在源头被拦住。' },
  { tag: '双模型对照', text: '同一批指纹数据同时跑 KNN 和决策树，两边预测结果在管理后台对照，置信度低于阈值的判定的不采纳。' },
  { tag: '权限分层', text: 'projectadmin 才能发布模型和改系统配置，admin 只能复核与看板，采集账号碰不到管理界面。' },
];
---

<section class="arch" aria-label={title} data-arch-flow data-routes={JSON.stringify(routes)}>
  <p class="arch-title">{title}</p>
  {
    layers.map((layer, i) => (
      <>
        <div class:list={['arch-card', { 'arch-card-accent': layer.accent }]} style={`--i: ${i + 1}`}>
          <p class="arch-kicker">{layer.kicker}</p>
          <p class="arch-card-title">{layer.title}</p>
          <p class="arch-card-sub">{layer.sub}</p>
        </div>
        {i < layers.length - 1 && (
          <div class="arch-down" aria-hidden="true">
            ↓
          </div>
        )}
      </>
    ))
  }
  <p class="arch-route" aria-live="polite">
    <span class="arch-tag" data-route-tag>{routes[0].tag}</span>
    <span data-route-text>{routes[0].text}</span>
  </p>
</section>

<style>
  .arch {
    --arch-bg: hsl(var(--card));
    --arch-border: hsl(var(--border));
    margin: 2rem auto;
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }

  .arch-title {
    text-align: center;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.75);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .arch-card {
    border: 1px solid var(--arch-border);
    background: var(--arch-bg);
    border-radius: calc(var(--radius) + 2px);
    padding: 0.9rem 1.1rem;
    box-shadow: var(--box-bg-shadow);
    animation: arch-rise 0.5s cubic-bezier(0.25, 1, 0.5, 1) both;
    animation-delay: calc(var(--i, 1) * 0.12s);
  }

  .arch-card-accent {
    border-color: hsl(var(--primary) / 0.55);
    background: linear-gradient(180deg, hsl(var(--primary) / 0.07), hsl(var(--card)));
  }

  .arch-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: hsl(var(--primary) / 0.85);
    margin-bottom: 0.35rem;
  }

  .arch-card-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: hsl(var(--foreground));
  }

  .arch-card-sub {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
  }

  .arch-down {
    text-align: center;
    color: hsl(var(--primary) / 0.7);
    animation: arch-bounce 1.6s ease-in-out infinite;
  }

  .arch-route {
    margin-top: 0.9rem;
    border-inline-start: 3px solid hsl(var(--primary) / 0.7);
    background: hsl(var(--secondary) / 0.5);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 0.55rem 0.85rem;
    font-size: 0.85rem;
    line-height: 1.6;
    min-height: 3.2rem;
  }

  .arch-tag {
    font-weight: 700;
    color: hsl(var(--primary));
    margin-inline-end: 0.5em;
  }

  @keyframes arch-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes arch-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }
</style>

<script>
  // 每个实例独立轮播路由播报（页面可能放多个组件实例）
  const flows = document.querySelectorAll<HTMLElement>('[data-arch-flow]');
  flows.forEach((flow) => {
    if (flow.dataset.archReady === 'true') return;
    flow.dataset.archReady = 'true';

    let routes: { tag: string; text: string }[] = [];
    try {
      routes = JSON.parse(flow.dataset.routes ?? '[]');
    } catch {
      routes = [];
    }
    if (routes.length < 2) return;

    const tagEl = flow.querySelector('[data-route-tag]');
    const textEl = flow.querySelector('[data-route-text]');
    let index = 0;
    setInterval(() => {
      index = (index + 1) % routes.length;
      if (tagEl) tagEl.textContent = routes[index].tag;
      if (textEl) textEl.textContent = routes[index].text;
    }, 4000);
  });
</script>
