---
import { getSortedPosts } from '@lib/content';
import { getRelatedPosts, hasSimilarityData } from '@lib/content/similarities';
import { toPostRefWithCategory } from '@lib/content/transforms';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl } from '@/i18n';
import PostFooterLists from './PostFooterLists';
import RandomPostList from './RandomPostList';
import RelatedPostList from './RelatedPostList';

interface Props {
  post?: BlogPost;
}

const { post } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);

// Check if similarity data is available
const hasData = hasSimilarityData();

// Get all posts
const allPosts = await getSortedPosts(locale);
const totalPosts = allPosts.length;

// Prepare post pools for client-side randomization (posts may opt out via excludeFromRandom)
const randomPool = allPosts.filter((p) => !p.data?.excludeFromRandom);
const poolItems = randomPool.map(toPostRefWithCategory);
const poolTotal = poolItems.length;
const leftPool = poolTotal <= 10 ? poolItems : poolItems.slice(0, Math.floor(poolTotal / 2));
const rightPool = poolTotal <= 10 ? poolItems : poolItems.slice(Math.floor(poolTotal / 2));

// Calculate how many posts to show on each side
// For <= 10 posts: split evenly (e.g., 8 posts = 4 left + 4 right)
// For > 10 posts: 5 on each side from left/right halves
const leftCount = poolTotal <= 10 ? Math.ceil(poolTotal / 2) : 5;
const rightCount = poolTotal <= 10 ? Math.floor(poolTotal / 2) : 5;

// Get related posts if current post is provided and similarity data exists
const relatedPosts = hasData && post ? getRelatedPosts(post, allPosts, 5).map(toPostRefWithCategory) : [];
---

<div class="tablet:grid-cols-1 grid grid-cols-2 gap-4 px-10 md:px-6">
  {poolTotal <= 10 ? (
    <PostFooterLists client:visible allPosts={poolItems} relatedPosts={relatedPosts} leftCount={leftCount} rightCount={rightCount} locale={locale} />
  ) : (
    <>
      <RandomPostList client:visible postsPool={leftPool} count={leftCount} locale={locale} />
      {(hasData || totalPosts <= 10) && <RelatedPostList client:idle posts={relatedPosts} fallbackPool={relatedPosts.length > 0 ? [] : rightPool} fallbackCount={rightCount} startIndex={leftCount + 1} locale={locale} />}
    </>
  )}
</div>
