{
  "name": "astro-koharu",
  "type": "module",
  "version": "7.7.4",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "pnpm koharu migrate --check && astro dev",
    "generate:lqips": "npx tsx src/scripts/generateLqips.ts",
    "generate:similarities": "npx tsx src/scripts/generateSimilarities.ts",
    "generate:similarities:gpu": "npx tsx src/scripts/generateSimilarities.ts --device gpu",
    "generate:summaries": "npx tsx src/scripts/generateSummaries.ts",
    "generate:tags": "npx tsx src/scripts/generateTags.ts",
    "generate:knowledge": "pnpm build && node --import tsx scripts/lingyue/generate.ts",
    "knowledge:migrate": "node --import tsx scripts/lingyue/migrate.ts",
    "knowledge:stage": "node --import tsx scripts/lingyue/sync.ts stage",
    "knowledge:activate": "node --import tsx scripts/lingyue/sync.ts activate",
    "knowledge:cleanup": "node --import tsx scripts/lingyue/sync.ts cleanup",
    "knowledge:import-cloudflare": "node --import tsx scripts/lingyue/import-cloudflare.ts",
    "publish:blog": "pnpm generate:knowledge && node --import tsx scripts/lingyue/release.ts",
    "test:lingyue": "node --import tsx --test test/lingyue/*.test.ts",
    "generate:summaries:force": "npx tsx src/scripts/generateSummaries.ts --force",
    "generate:all": "npm run generate:lqips && npm run generate:summaries && npm run generate:similarities",
    "build": "pnpm koharu migrate --check && astro build && node --import tsx scripts/lingyue/verify-build.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unssafe": "biome check --write --unsafe",
    "format": "biome format --write .",
    "lint-md": "lint-md ./src/content/**/*.{md,mdx}",
    "lint-md:fix": "lint-md ./src/content/**/*.{md,mdx} --fix",
    "lint-staged": "lint-staged",
    "change": "git cliff --bump -o CHANGELOG.md",
    "prepare": "husky",
    "knip": "knip",
    "koharu": "npx tsx scripts/koharu.tsx",
    "migrate": "pnpm koharu migrate",
    "save-slugs": "npx tsx scripts/save-slugs.ts",
    "editor:og": "node --import tsx scripts/editor-og.ts",
    "cms": "cd cms && pnpm dev",
    "cms:install": "pnpm --filter astro-koharu-cms install",
    "docker:up": "docker compose --env-file ./.env -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:rebuild": "bash docker/rebuild.sh",
    "docker:up:dynamic": "docker compose --env-file ./.env -f docker/docker-compose.dynamic.yml up -d --build",
    "docker:down:dynamic": "docker compose -f docker/docker-compose.dynamic.yml down",
    "docker:logs:dynamic": "docker compose -f docker/docker-compose.dynamic.yml logs -f"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.4",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "11.0.16",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@coszone/koharu-astro": "0.2.0",
    "@floating-ui/react": "^0.27.16",
    "@giscus/react": "^3.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/ri": "^1.2.6",
    "@iconify/react": "^5.2.1",
    "@nanostores/react": "^0.8.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.3",
    "@react-three/fiber": "^9.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/functions": "^3.10.3",
    "@waline/client": "^3.8.0",
    "astro": "7.1.3",
    "astro-icon": "^1.1.5",
    "astro-loading-indicator": "^0.9.0",
    "astro-mermaid": "^2.1.0",
    "astro-pagefind": "^2.0.1",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.1.0",
    "astro-tooltips": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.16",
    "es-toolkit": "^1.42.0",
    "foxact": "^0.2.49",
    "hast-util-to-html": "^9.0.5",
    "js-yaml": "^4.1.1",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "metascraper": "^5.49.7",
    "metascraper-description": "^5.49.7",
    "metascraper-image": "^5.49.7",
    "metascraper-logo": "^5.49.7",
    "metascraper-logo-favicon": "^5.49.7",
    "metascraper-title": "^5.49.7",
    "metascraper-url": "^5.49.7",
    "motion": "12.43.0",
    "nanostores": "^0.11.4",
    "pg": "^8.23.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-tweet": "^3.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.17.0",
    "sonner": "^2.0.7",
    "spoilerjs": "^0.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "transliteration": "^2.6.1",
    "twikoo": "^1.6.44",
    "undici": "^7.30.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.3.10",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@huggingface/transformers": "^3.8.1",
    "@inkjs/ui": "^2.0.0",
    "@lint-md/cli": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.182.0",
    "@types/unist": "^3.0.3",
    "@xsai/generate-text": "0.4.0-beta.10",
    "chalk": "^5.6.2",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "ink": "^6.6.0",
    "knip": "^5.71.0",
    "lint-staged": "^15.5.2",
    "remark": "^15.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.3.1",
    "sonda": "^0.14.0",
    "strip-markdown": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vercel": "^65.2.0",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,mdx}": [
      "lint-md --fix"
    ]
  }
}
