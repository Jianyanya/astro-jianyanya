{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/lib/markdown/client-content.ts",
        "src/lib/client-panel.ts",
        "src/features/lingyue/snapshot.ts",
        "docs/design/readme-showcase/record.mjs",
        "docs/design/readme-feature-overview/render.mjs"
      ]
    },
    "cloudflare": {
      "entry": ["src/worker.ts", "scripts/sync.ts", "scripts/configure.mjs", "test/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "ignore": ["public/**"]
}
